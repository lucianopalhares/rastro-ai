# Chave usada pelo ai-indexer para gerar embeddings externos.
OPENAI_API_KEY=

# Porta publicada externamente pelo indexador Python.
AI_INDEXER_PORT=18473

# Observabilidade Langfuse self-hosted (opcional; requer docker-compose.langfuse.yml).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_UI_PORT=38917
LANGFUSE_MEDIA_PORT=38918
LANGFUSE_POSTGRES_PASSWORD=postgres
LANGFUSE_REDIS_PASSWORD=myredissecret
LANGFUSE_MINIO_PASSWORD=miniosecret
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# Opcional: preço direto em USD por token de entrada; vazio usa o modelo do Langfuse.
LANGFUSE_EMBEDDING_INPUT_COST_PER_TOKEN=
# Opcional: tokenizer tiktoken para modelos customizados.
EMBEDDING_TOKENIZER_MODEL=
